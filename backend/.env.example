# Gemini API credentials
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase credentials (optional in dev, fallback to mock DB/auth is enabled)
FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-service-account.json

# ChromaDB persistence directory (defaults to backend/chroma_db if left blank)
CHROMA_PERSIST_DIR=path/to/chroma_data

# Allowed origins for CORS (JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
